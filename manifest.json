{
  "manifest_version": 3,
  "name": "SPU Annotation Helper",
  "version": "2.4.1",
  "description": "Comprehensive toolkit for annotating at Shopee",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "clipboardRead"
  ],
  "host_permissions": [
    "https://spu.shopee.tw/*",
    "https://shopee.tw/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SPU Annotation Helper"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://spu.shopee.tw/annotation/*"
      ],
      "js": [
        "src/cn-variants.js",
        "src/page-adapter.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://spu.shopee.tw/annotation/*"
      ],
      "js": [
        "src/recall-seed.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://spu.shopee.tw/annotation/*"
      ],
      "js": [
        "src/cat-translations.js",
        "src/content.js"
      ],
      "css": [
        "src/overlay.css"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://shopee.tw/*"
      ],
      "js": [
        "src/recall-unlock.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://shopee.tw/*"
      ],
      "js": [
        "src/recall-adapter.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://shopee.tw/*"
      ],
      "js": [
        "src/product-key.js",
        "src/recall-state.js",
        "src/recall-duplicates.js",
        "src/recall-stash.js",
        "src/recall-declutter.js",
        "src/recall-clipboard-search.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
